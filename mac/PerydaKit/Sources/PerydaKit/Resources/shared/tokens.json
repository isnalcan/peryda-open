{
  "$comment": "Peryda 'Kenar Notu' design tokens shared by the web engine (CSS variables) and the Mac app (Swift). Yarn stroke colours meet 4.5:1 on paper and on raised surfaces in both themes (see shared/tools/check-contrast.py).",
  "version": 1,
  "palette": {
    "light": {
      "paper": "#F7F6F3",
      "paperRaised": "#FFFFFF",
      "paperSunken": "#EFEDE8",
      "ink": "#211F1A",
      "inkSoft": "#5C574C",
      "inkFaint": "#716B60",
      "accent": "#33604F",
      "accentStrong": "#284E3F",
      "accentTint": "rgba(51, 96, 79, 0.09)",
      "line": "rgba(33, 31, 26, 0.10)",
      "lineStrong": "rgba(33, 31, 26, 0.18)",
      "errorText": "#A3131A"
    },
    "dark": {
      "paper": "#131110",
      "paperRaised": "#252220",
      "paperSunken": "#1B1917",
      "ink": "#E8E3D9",
      "inkSoft": "#BDB5A8",
      "inkFaint": "#9C9488",
      "accent": "#8FB8A6",
      "accentStrong": "#ADD1C2",
      "accentTint": "rgba(143, 184, 166, 0.12)",
      "line": "rgba(255, 255, 255, 0.12)",
      "lineStrong": "rgba(255, 255, 255, 0.20)",
      "errorText": "#FF7D7F"
    }
  },
  "yarn": {
    "coral": { "light": "#9E4B2B", "dark": "#E0A07F", "highlightAlpha": 0.16 },
    "mint": { "light": "#33604F", "dark": "#8FB8A6", "highlightAlpha": 0.16 },
    "sky": { "light": "#2E5874", "dark": "#93B5CE", "highlightAlpha": 0.16 },
    "amber": { "light": "#85631C", "dark": "#D6B46E", "highlightAlpha": 0.18 },
    "lavender": { "light": "#6B4868", "dark": "#C4A2C1", "highlightAlpha": 0.16 },
    "cream": { "light": "#6F6457", "dark": "#BDB2A4", "highlightAlpha": 0.18 }
  },
  "pageSheet": {
    "$comment": "PDF pages are always drawn on paper colour so highlights can use multiply in both themes.",
    "light": "#FFFFFF",
    "dark": "#F7F6F3"
  },
  "typography": {
    "reading": "Literata",
    "interface": "Instrument Sans",
    "cardTitleSize": 11,
    "cardTitleTracking": 0.08,
    "cardBodySize": 15,
    "cardBodyLeading": 1.5
  },
  "geometry": {
    "pageWorldWidth": 760,
    "pageGap": 32,
    "pageScaleMin": 0.5,
    "pageScaleMax": 2.5,
    "laneOffset": 75,
    "laneTop": 16,
    "laneGap": 18,
    "anchorLift": 14,
    "cardWidth": 390,
    "cardAttachY": 26,
    "subLaneGap": 68,
    "bezierMinSpan": 60,
    "bezierSpanRatio": 0.46,
    "areaMinWidth": 0.02,
    "areaMinHeight": 0.015,
    "areaCropScale": 2,
    "textlessPageCharacterThreshold": 15,
    "cardRadius": 10,
    "previewImageMaxHeight": 120,
    "recallBlur": 6
  },
  "yarnStroke": {
    "haloWidth": 3.5,
    "haloOpacity": 0.12,
    "mainWidth": 1.75,
    "mainOpacity": 0.82,
    "startKnotRadius": 3,
    "endKnotRadius": 3.5
  },
  "highlighter": {
    "$comment": "The reader's own highlights (Vurgula): a yellow highlighter multiplied into the page, the same on paper in both themes.",
    "color": "#F4CF3A",
    "alpha": 0.45,
    "$colorsComment": "The four highlighter colours the reader can choose (hold Vurgula); a journal entry's highlightColor names one, absent = yellow.",
    "order": ["yellow", "green", "pink", "blue"],
    "colors": {
      "yellow": "#F4CF3A",
      "green": "#8FD18B",
      "pink": "#F59FC3",
      "blue": "#8EC3F0"
    }
  },
  "find": {
    "$comment": "Find in the document: every match tinted, the current one stronger (multiplied into the page).",
    "color": "#FF9F0A",
    "alpha": 0.28,
    "currentAlpha": 0.7
  }
}
