{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peryda",
  "version": "0.1.0",
  "identifier": "com.isnalcan.peryda.windows",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5191",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Peryda",
        "width": 1360,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Peryda",
    "shortDescription": "Read PDF and EPUB books with margin threads, using your own AI key.",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish",
          "German",
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_NOTICES-rust.txt": "THIRD_PARTY_NOTICES-rust.txt"
    },
    "copyright": "Copyright (c) 2026 isnalcan. MIT licence; see LICENSE.txt and NOTICE.txt."
  }
}
